/*Create categorical variable for age (Cohort)*/
/*Post-vaccination breadth variable with cutoff as 4-fold increase of the lower limit of detection (Post_Breadth)*/
data HIL214a;
	set HIL214;
	if study = 202 and Age >=4 and Age < 9 then Cohort='4- <9 years of age';
	if study = 202 and Age >=1 and Age < 4 then Cohort='1- <4 years of age';
	if study = 202 and Age <1 and Age >= 0.5 then Cohort='0.5-<1 years';
	else if study = 202 and Age <0.5 then delete;
	if study = 212 then cohort='0.4 years of age';
 	if study = 215 then Cohort='18-<50 years';
	if GII4Syd_Pre <=60 and GII4AL_Pre <= 60 and GII4WI_Pre <= 60 and GII4SF_Pre <=60 and GII4_1997_Pre <= 60 then Preimmune=0;
		else preimmune=1;
 	array Post(*) GII4C_Post GII4Syd_Post GII4AL_Post GII4WI_Post GII4SF_Post;
		Post_Breadth=0;
		do i = 1 to dim(Post); 
	 		if Post(i) >240 then Post_Breadth=Post_Breadth +1;
	end;
	drop i;
run;

