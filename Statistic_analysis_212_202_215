/*Figure 3H*/
data NOR212_b1;
	set NOR212_a;
	if GII4SY_1 <= 60 and GII4AL_1 <= 60 and GII4WI_1 <=60 and GII4SF_1 <= 60 then Preimmune=0;
	else preimmune=1;
	if AcuteGE=1 or AcuteGE=2 or AcuteGE=3 then disease=1;
	else disease=0;
run;

proc freq data=NOR212_b1; table exposure*disease/ norow nocol nopercent fisher; run;

data NOR212_b2;
	set NOR212_b1;
	array visit3(*) GII4c_3 GII4SY_3 GII4AL_3 GII4WI_3 GII4SF_3;
	V3_Breadth=0;
	do i = 1 to dim(visit3); 
	 if visit3(i) = . then V3_Breadth= .;
	 else if visit3(i) >240 then V3_Breadth=V3_Breadth +1;
	end;
	drop i;
run;
proc contents data=NOR212_b2; run;
proc sort data=NOR212_b2; by disease; run;
proc freq data=NOR212_b2; by disease; table exposure*V3_Breadth/ norow nocol nopercent fisher; run;

