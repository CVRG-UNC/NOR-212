/*Figure 3I*/

data NOR212_b4; set NOR212_b3; if AcuteGE = 1 or AcuteGE = 2 or AcuteGE = 3 then Outcome=1; else Outcome = 0; run; 
data NOR212_b5; set NOR212_b4; 
	if exposure = 1 and outcome = 1 then VxGe= "HIL-214_AGE";
