	sheet='NOR212_complete';
	getnames=yes;
	options msglevel=I;
run;

proc contents data=NOR212_a; run;

/*Evaluate association between AcuteGE and first GII.4 infecting strain*/
proc freq data=NOR212_a; where AcuteGE ne 0; table FirstGII4*AcuteGE/norow nocol nopercent; exact fisher/ mc n=500000;  run;

/*Evaluate association between Vaccination and first GII.4 infecting strain*/
proc freq data=NOR212_a; where AcuteGE ne 0; tables Exposure*(FirstGII4)/norow nocol nopercent; exact fisher/ mc n=50000; run; 

/*Full model + reduced models - linear regression*/
proc sort data=NOR212_a; by exposure /*vaccination status*/; run;
proc genmod data=NOR212_a; by exposure; class FirstGII4 Country; model GII4c_4=AcuteGE|FirstGII4|Country|Age_years; run;
proc genmod data=NOR212_a; by exposure; class FirstGII4 Country; model GII4c_4=AcuteGE FirstGII4 Country Age_years; run;
proc genmod data=NOR212_a; by exposure; class FirstGII4 Country; model GII4c_4=AcuteGE FirstGII4|Country Age_years; run;
proc genmod data=NOR212_a; by exposure; class FirstGII4 Country; model GII4c_4=FirstGII4|Country; run;

/*Remove observations without infection during follow-up*/
data NOR212_b; set NOR212_a; if AcuteGE=1 then GE=0; if AcuteGE=2 or AcuteGE=3 then GE=1; else if AcuteGE=0 then delete; run;

/*Estimate mean geometric titers for each GII.4 variant, stratified by AcuteGE and vaccination status*/
proc sort data=NOR212_b; by GE exposure; run;
proc surveymeans data=NOR212_b geomean gmclm plots=none; where FirstGII4='GII4 SF'; by GE exposure; var GII4c_4 GII4SF_4 GII4SY_4 GII4WI_4 GII4AL_4; run;
proc surveymeans data=NOR212_b geomean gmclm plots=none; where FirstGII4='GII4 Syd'; by GE exposure; var GII4c_4 GII4SF_4 GII4SY_4 GII4WI_4 GII4AL_4; run;
proc surveymeans data=NOR212_b geomean gmclm plots=none; where FirstGII4='GII4 WI'; by GE exposure; var GII4c_4 GII4SF_4 GII4SY_4 GII4WI_4 GII4AL_4; run;
proc surveymeans data=NOR212_b geomean gmclm plots=none; where FirstGII4='GII4 AL'; by GE exposure; var GII4c_4 GII4SF_4 GII4SY_4 GII4WI_4 GII4AL_4; run;
proc surveymeans data=NOR212_b geomean gmclm plots=none; where FirstGII4='GII4 U'; by GE exposure; var GII4c_4 GII4SF_4 GII4SY_4 GII4WI_4 GII4AL_4; run;

/*Estimate association between gastroenteritis severity and post-infection sNAbts, stratified by vaccination status*/
